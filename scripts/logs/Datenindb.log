CREATE TABLE data (
	id INTEGER NOT NULL, 
	user VARCHAR(50) NOT NULL, 
	places_id INTEGER NOT NULL, 
	controller_id INTEGER NOT NULL, 
	tracks_id INTEGER NOT NULL, 
	drink_count INTEGER NOT NULL, 
	kiff_count INTEGER NOT NULL, 
	datum TIMESTAMP NOT NULL, 
	rennen_tag INTEGER NOT NULL, 
	gesamt_score INTEGER NOT NULL, 
	beamer BOOLEAN NOT NULL, 
	fehlstarts INTEGER NOT NULL, 
	created_at TIMESTAMP DEFAULT (CURRENT_TIMESTAMP) NOT NULL, 
	updated_at TIMESTAMP DEFAULT (CURRENT_TIMESTAMP) NOT NULL, 
	PRIMARY KEY (id), 
	FOREIGN KEY(places_id) REFERENCES game_place (id), 
	FOREIGN KEY(controller_id) REFERENCES controller (id), 
	FOREIGN KEY(tracks_id) REFERENCES game_tracks (id)
)


